---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogImageAlt?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogUrl?: string;
  ogType?: string;
  ogSiteName?: string;
}

const {
  title,
  description = 'controlthrive builds Paos — the operating system for placement agents. One agent runs the raise: search, standardization, matching, campaigns and reporting, every claim cited back to its source.',
  ogImage = '/api/og/home.png',
  ogImageAlt,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  ogUrl = Astro.url.href,
  ogType = 'website',
  ogSiteName = 'controlthrive',
} = Astro.props;

const baseUrl = (Astro.site || Astro.url.origin).toString();
const ogVersion =
  process.env.VERCEL_GIT_COMMIT_SHA ||
  process.env.VERCEL_DEPLOYMENT_ID ||
  process.env.OG_IMAGE_VERSION ||
  'local';
const resolvedOgImageUrl = new URL(ogImage, baseUrl);
resolvedOgImageUrl.searchParams.set('v', ogVersion);
const resolvedOgImage = resolvedOgImageUrl.href;
const ga4Id = import.meta.env.PUBLIC_GA4_ID?.trim() || 'G-LLMXBYB3P8';
const gtmId = import.meta.env.PUBLIC_GTM_ID?.trim() || '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=controlthrive-logo" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta property="og:site_name" content={ogSiteName} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={ogUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

    <meta name="theme-color" content="#fafafa" />

    <script is:inline>
      (() => {
        const getStoredTheme = () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        };

        const preferredTheme = getStoredTheme();
        const resolvedTheme =
          preferredTheme ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

        document.documentElement.classList.toggle('dark', resolvedTheme === 'dark');

        const meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', resolvedTheme === 'dark' ? '#101012' : '#fafafa');
        }
      })();
    </script>

    <script is:inline define:vars={{ ga4Id, gtmId }}>
      window.dataLayer = window.dataLayer || [];
      if (gtmId) {
        window.dataLayer.push({ 'gtm.start': Date.now(), event: 'gtm.js' });
        const firstScript = document.getElementsByTagName('script')[0];
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtm.js?id=${gtmId}`;
        firstScript.parentNode.insertBefore(script, firstScript);
      } else {
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${ga4Id}`;
        document.head.appendChild(script);
        window.gtag('js', new Date());
        window.gtag('config', ga4Id);
      }
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=Geist+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" is:inline>
      {JSON.stringify({
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'Organization',
            '@id': `${baseUrl}#organization`,
            name: 'controlthrive',
            founder: {
              '@type': 'Person',
              name: 'Servando Torres',
            },
            email: 'servando@controlthrive.com',
            url: baseUrl,
            description,
            sameAs: [
              'https://x.com/vandotorres',
              'https://www.linkedin.com/in/servando-torres-239a26b0/',
              'https://github.com/Servando1990',
            ],
          },
          {
            '@type': 'SoftwareApplication',
            '@id': `${baseUrl}#pa-os`,
            name: 'Paos',
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Web',
            url: new URL('/pa-os', baseUrl).href,
            description:
              'The operating system for boutique placement agents: search, standardization, matching, and reporting under human control, with campaign drafting in build.',
            creator: { '@id': `${baseUrl}#organization` },
          },
        ],
      })}
    </script>
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          ></iframe>
        </noscript>
      )
    }
    <slot />

    <script is:inline define:vars={{ gtmId }}>
      (() => {
        const attributionKeys = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
        const currentUrl = new URL(window.location.href);
        const currentAttribution = Object.fromEntries(
          attributionKeys
            .map((key) => [key, currentUrl.searchParams.get(key)])
            .filter(([, value]) => value),
        );

        if (Object.keys(currentAttribution).length) {
          try {
            sessionStorage.setItem('controlthrive_attribution', JSON.stringify(currentAttribution));
          } catch {
            // Attribution still reaches GA4 on the current page when storage is unavailable.
          }
        }

        const storedAttribution = () => {
          try {
            return JSON.parse(sessionStorage.getItem('controlthrive_attribution') || '{}');
          } catch {
            return {};
          }
        };

        document.addEventListener('click', (click) => {
          const element = click.target instanceof Element ? click.target.closest('a[data-growth-cta]') : null;
          if (!(element instanceof HTMLAnchorElement)) return;

          const attribution = { ...storedAttribution(), ...currentAttribution };
          const destination = new URL(element.href, window.location.href);
          if (destination.hostname === 'cal.com') {
            for (const [key, value] of Object.entries(attribution)) {
              if (typeof value === 'string' && value) destination.searchParams.set(key, value);
            }
            element.href = destination.toString();
          }

          const parameters = {
            cta_id: element.dataset.growthCta || 'founding_partner',
            cta_location: element.dataset.growthLocation || 'body',
            offer_wedge: element.dataset.growthWedge || 'founding_partner',
            page_path: window.location.pathname,
            link_text: (element.textContent || '').trim().replace(/\s+/g, ' ').slice(0, 100),
            link_url: `${destination.origin}${destination.pathname}`,
            campaign_id: attribution.utm_campaign || '(not set)',
            content_id: attribution.utm_content || '(not set)',
          };

          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({ event: 'founding_partner_cta_click', ...parameters });
          if (!gtmId && typeof window.gtag === 'function') {
            window.gtag('event', 'founding_partner_cta_click', parameters);
          }
        });
      })();
    </script>
  </body>
</html>
