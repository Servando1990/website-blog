---
import { bookingUrl, trustPrinciples } from "../lib/siteContent";

interface Props {
  index?: string;
  title?: string;
  copy?: string;
  showPrinciples?: boolean;
  primaryHref?: string;
  primaryLabel?: string;
  primaryExternal?: boolean;
  secondaryHref?: string;
  secondaryLabel?: string;
}

const {
  index = "07",
  title = "Run one live mandate with Paos.",
  copy = "Design partners get the product plus founder support on a live raise: start from a mandate, rank the book against it, and search for the names you're missing. The pipeline keeps score.",
  showPrinciples = true,
  primaryHref = bookingUrl,
  primaryLabel = "Join the design-partner program",
  primaryExternal = true,
  secondaryHref = "/pa-os",
  secondaryLabel = "See Paos",
} = Astro.props;
---

<section class="section section--ruled">
  <div class="wrap">
    <header class="sec-head">
      <span class="sec-head__index">{index}</span>
      <span class="sec-head__label">Next step</span>
    </header>

    <h2 class="cta-final__title">{title}</h2>
    <p class="sec-lede">{copy}</p>

    <div class="cta-final__actions">
      <a
        class="btn-ink"
        href={primaryHref}
        target={primaryExternal ? "_blank" : undefined}
        rel={primaryExternal ? "noopener noreferrer" : undefined}
        data-growth-cta={primaryExternal ? "founding-partner" : undefined}
        data-growth-location={primaryExternal ? "final-cta" : undefined}
        data-growth-wedge={primaryExternal ? "founding-partner" : undefined}
      >
        {primaryLabel}
      </a>
      <a class="btn-line" href={secondaryHref}>
        {secondaryLabel}
      </a>
    </div>

    {
      showPrinciples && (
        <div class="principles" aria-label="Operating principles">
          {trustPrinciples.map((principle) => (
            <span>{principle.title}</span>
          ))}
        </div>
      )
    }
  </div>
</section>
