---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { tools } from '../lib/siteContent';
---

<Layout
  title="Tools | Controlthrive Studios"
  description="Free tools from Controlthrive Studios for teams evaluating data quality and operating workflows."
>
  <Header />

  <main>
    <section class="page-intro">
      <div class="wrap">
        <span class="mono-label">Tools</span>
        <h1 class="page-title">
          Small tools for clearer operating decisions.
        </h1>
        <p class="page-lede">
          Standalone utilities from Controlthrive Studios. Use them freely;
          Paos remains the product we build.
        </p>
      </div>
    </section>

    <section class="section section--ruled" style="padding-top: 0; border-top: 0">
      <div class="wrap">
        <div class="work-list">
          {tools.map((tool) => (
            <article class="tool-row">
              <div>
                <span class="mono-label">Tool</span>
                <h3 style="margin-top: 0.8rem">{tool.name}</h3>
              </div>
              <div class="tool-row__copy">
                <p>{tool.summary}</p>
                <p>{tool.audience}</p>
                <p>{tool.outcome}</p>
                <div class="tool-row__actions">
                  <a class="btn-ink" href={tool.href} target="_blank" rel="noopener noreferrer">
                    {tool.ctaLabel}
                  </a>
                  <a class="btn-line" href="/pa-os">
                    See Paos
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CtaBand index="02" showPrinciples={false} />
  </main>

  <Footer />
</Layout>
