---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { publishedCaseStudies } from '../lib/caseStudies';
---

<Layout
  title="Work | Controlthrive Studios"
  description="Selected systems from Controlthrive Studios — the judgment-heavy work that sits beside Paos."
>
  <Header />

  <main>
    <section class="page-intro">
      <div class="wrap">
        <span class="mono-label">Selected work</span>
        <h1 class="page-title">
          Production systems for difficult operating problems.
        </h1>
        <p class="page-lede">
          Selected work from the studio across private capital, research,
          pricing, and data operations — the same standard of judgment Paos
          is built on.
        </p>
      </div>
    </section>

    <section class="section section--ruled" style="padding-top: 0; border-top: 0">
      <div class="wrap">
        <div class="work-list">
          {publishedCaseStudies.map((study) => (
            <article class="work-row">
              <div class="work-row__meta">
                <span class="mono-label">{study.industry}</span>
                <p class="work-row__outcome">{study.featuredOutcome}</p>
              </div>
              <div class="work-row__body">
                <h2>
                  <a href={`/case-studies/${study.slug}`}>{study.title}</a>
                </h2>
                <p>{study.cardSummary}</p>
                <div class="work-row__links">
                  <a class="link-quiet" href={`/case-studies/${study.slug}`}>
                    Read case study
                  </a>
                  {study.proofLink ? (
                    <a class="link-quiet" href={study.proofLink.href} target="_blank" rel="noopener noreferrer">
                      {study.proofLink.label}
                    </a>
                  ) : null}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      index="02"
      title="Have a similar operating problem?"
      copy="Controlthrive Studios takes on a small number of founder-led engagements alongside Paos."
      showPrinciples={false}
      primaryLabel="Discuss an engagement"
      secondaryHref="/pa-os"
      secondaryLabel="See Paos"
    />
  </main>

  <Footer />
</Layout>
