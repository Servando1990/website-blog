---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import { publishedCaseStudies } from '../lib/caseStudies';
---

<Layout
  title="Case Studies | controlthrive"
  description="Selected controlthrive systems delivered across private capital, research, pricing, and data operations."
>
  <Header />

  <main>
    <section class="page-intro">
      <div class="wrap">
        <span class="mono-label">Selected work</span>
        <h1 class="page-title">
          Production systems for difficult operating problems.
        </h1>
        <p class="page-lede">
          Case studies across private capital, research, pricing, and data
          operations. They show the kind of judgment-heavy work controlthrive
          can take from operating problem to working software.
        </p>
      </div>
    </section>

    <section class="section section--ruled" style="padding-top: 0; border-top: 0">
      <div class="wrap">
        <div class="work-list">
          {publishedCaseStudies.map((study) => (
            <article class="work-row">
              <div class="work-row__meta">
                <span class="mono-label">{study.industry}</span>
                <p class="work-row__outcome">{study.featuredOutcome}</p>
              </div>
              <div class="work-row__body">
                <h2>
                  <a href={`/case-studies/${study.slug}`}>{study.title}</a>
                </h2>
                <p>{study.cardSummary}</p>
                <div class="work-row__links">
                  <a class="link-quiet" href={`/case-studies/${study.slug}`}>
                    Read case study
                  </a>
                  {study.proofLink ? (
                    <a class="link-quiet" href={study.proofLink.href} target="_blank" rel="noopener noreferrer">
                      {study.proofLink.label}
                    </a>
                  ) : null}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <CtaBand
      index="02"
      title="Have a similar operating problem?"
      copy="controlthrive takes on a small number of founder-led AI, data, and decision-system engagements alongside PA-OS."
      showPrinciples={false}
      primaryLabel="Discuss an engagement"
      secondaryHref="/pa-os"
      secondaryLabel="See PA-OS"
    />
  </main>

  <Footer />
</Layout>
