---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Glyph from "../components/Glyph.astro";
import {
  bookingUrl,
  founderProfile,
  productPillars,
  trustedCompanies,
} from "../lib/siteContent";

const founderParagraphs = [
  founderProfile.paragraphs[0],
  founderProfile.paragraphs[2],
];

// The home page has one job: a placement agent lands here and knows, in one
// screen, what Paos is and what controlthrive builds.

const raiseStages = [
  { label: "Mandate", value: "Live" },
  { label: "Search", value: "12 sourced" },
  { label: "Pipeline", value: "8 identified" },
  { label: "Matching", value: "When a book exists" },
  { label: "Reporting", value: "From the raise" },
];

const partnerSnapshot = [
  { title: "A live raise", copy: "Start from a deck or a sentence." },
  { title: "Names on that raise", copy: "Search even if the book is empty." },
  { title: "Founder support", copy: "Direct setup and iteration." },
];

---

<Layout
  title="Paos — the operating system for placement agents | controlthrive"
  description="Paos runs the raise. Drop a mandate, find names even with an empty book, and keep the pipeline as the scoreboard. Closed beta."
  ogImage="/api/og/home.png"
  ogImageAlt="Paos by controlthrive — the operating system for placement agents."
>
  <Header />

  <main>
    <!-- Hero — the product is the subject of the sentence. -->
    <section class="hero">
      <div class="wrap hero__grid">
        <div>
          <p class="hero__eyebrow reveal">
            <span class="hero__chip"
              ><i class="dot-live"></i><span class="brand-name">Paos</span> ·
              Closed beta</span
            >
          </p>
          <h1 class="hero__title reveal" style="--reveal-delay: 60ms">
            Your CRM stores names. Paos runs the raise.
          </h1>
          <p class="hero__lede reveal" style="--reveal-delay: 120ms">
            Drop a mandate — a deck or a sentence. Paos finds names for that
            raise even if the book is empty. Pipeline is the scoreboard.
            Matching the book is an upgrade, not the start.
          </p>
          <div class="hero__actions reveal" style="--reveal-delay: 180ms">
            <a
              class="btn-ink"
              href={bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-growth-cta="join-design-partners"
              data-growth-location="home-hero"
              data-growth-wedge="live-mandate"
            >
              Run a live mandate
            </a>
            <a class="link-quiet" href="/pa-os">See the product</a>
          </div>
        </div>

        <p class="sr-only">
          Paos starts from a mandate. It finds names for that raise even
          with nobody in the book. A person approves every change; nothing
          investor-facing sends itself.
        </p>

        <!-- The product, collaged: the raise behind, the find-names ask over
             it, the review card in front. The book is not the object. -->
        <div
          class="deck reveal"
          style="--reveal-delay: 240ms"
          aria-hidden="true"
        >
          <div class="deck__plane">
            <div class="deck__card deck__card--book">
              <div class="dcard__bar">
                <Glyph size={12} />
                <span>Project Solís</span>
                <span class="dcard__meta">live raise</span>
              </div>
              <ul class="dcard__rows">
                <li class="is-cited"><b>Rockmont Family Office</b><i>Identified</i></li>
                <li><b>Aldwych Capital Office</b><i>New</i></li>
                <li><b>Talstein Multi-Family</b><i>New</i></li>
                <li><b>Meridian Trust Office</b><i>Out</i></li>
                <li><b>Larkmere Capital</b><i>Talking</i></li>
                <li><b>Gatewood Capital</b><i>Passed</i></li>
                <li><b>Halcyon Partners</b><i>Deep</i></li>
              </ul>
            </div>

            <div class="deck__card deck__card--ask">
              Find investors for <span class="deck__at">@Project Solís</span>
            </div>

            <svg
              class="deck__wires"
              viewBox="0 0 100 100"
              preserveAspectRatio="none"
              fill="none"
              aria-hidden="true"
            >
              <path
                id="wireA"
                class="deck__wire"
                vector-effect="non-scaling-stroke"
                d="M31 14 C 31 23, 23 24, 23 31"></path>
              <path
                id="wireB"
                class="deck__wire"
                style="--wd:0.5s"
                vector-effect="non-scaling-stroke"
                d="M85 40 C 95 39, 78 27, 68 24"></path>
              <circle class="deck__spark" r="1.1">
                <animateMotion dur="2.8s" repeatCount="indefinite" begin="0.9s">
                  <mpath href="#wireA" xlink:href="#wireA"></mpath>
                </animateMotion>
              </circle>
              <circle class="deck__spark" r="1.1">
                <animateMotion dur="2.8s" repeatCount="indefinite" begin="2.1s">
                  <mpath href="#wireB" xlink:href="#wireB"></mpath>
                </animateMotion>
              </circle>
            </svg>

            <div class="rq deck__card deck__card--front" data-rq>
              <div class="rq__bar">
                <Glyph size={14} />
                <span class="rq__title">Paos · agents at work</span>
                <span class="rq__count"
                  ><i class="dot-live"></i><span data-rq-step>3 / 5</span></span
                >
              </div>

              <article class="rq__item rq__item--active" data-rq-active>
                <div class="rq__kind-row">
                  <span class="rq__kind" data-rq-kind>Search</span>
                  <span class="rq__conf" data-rq-conf>sources attached</span>
                </div>
                <p class="rq__claim" data-rq-claim>
                  Found 12 investors for Project Solís.
                </p>
                <p class="rq__evidence" data-rq-evidence>
                  no book to dedup against · 4 withheld, no evidence
                </p>
                <div class="rq__actions">
                  <span class="rq__approve">Approve</span>
                  <span class="rq__edit">Edit</span>
                </div>
                <span class="rq__logged" data-rq-logged
                  >✓ Added to mandate — decision logged</span
                >
              </article>

              <article class="rq__item rq__item--queued" data-rq-queued>
                <div class="rq__kind-row">
                  <span class="rq__kind" data-rq-next-kind>Organize</span>
                </div>
                <p class="rq__claim" data-rq-next-claim>
                  Turned the deck into a review-ready mandate.
                </p>
              </article>

              <div class="rq__foot" data-rq-foot>
                a name without a source never reaches this list
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Proof strip -->
    <section class="proof" aria-label="Selected clients">
      <div class="wrap proof__row">
        <span class="mono-label">Founder’s systems in production at</span>
        <div class="proof__names">
          {trustedCompanies.map((company) => <span>{company}</span>)}
        </div>
      </div>
    </section>

    <!-- 01 The product -->
    <section class="section section--ruled" id="product">
      <div class="wrap">
        <header class="sec-head">
          <span class="sec-head__index">01</span>
          <span class="sec-head__label">The product</span>
        </header>

        <div class="product-statement reveal">
          <h2>The raise is the job. The book can wait.</h2>
        </div>

        <div class="raise-run reveal" style="--reveal-delay: 100ms">
          <div class="raise-run__head">
            <span>Project Solís · no book required</span>
            <span><i class="dot-live"></i>Live mandate</span>
          </div>
          <ol>
            {
              raiseStages.map((stage, index) => (
                <li>
                  <span class="raise-run__num">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <strong>{stage.label}</strong>
                  <span>{stage.value}</span>
                </li>
              ))
            }
          </ol>
        </div>

        <ul class="svc-list" style="margin-top: clamp(2rem, 5vw, 3rem)">
          {
            productPillars.map((pillar, index) => (
              <li
                class="svc-row reveal"
                style={`--reveal-delay: ${index * 70}ms`}
              >
                <div class="svc-row__lead">
                  <span class="svc-row__num">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <h3>{pillar.title}</h3>
                </div>
                <div class="svc-row__copy">
                  <p>{pillar.summary}</p>
                </div>
              </li>
            ))
          }
        </ul>

        <div class="product-cta reveal">
          <a class="link-quiet" href="/pa-os">See Paos at work</a>
        </div>
      </div>
    </section>

    <!-- 02 Selective services — visible, but secondary to Paos. -->
    <section class="section section--ruled" id="services">
      <div class="wrap">
        <header class="sec-head">
          <span class="sec-head__index">02</span>
          <span class="sec-head__label">Beyond Paos</span>
        </header>

        <div class="lane__copy">
          <h2 class="sec-title reveal">Selective services.</h2>
          <p class="sec-lede reveal" style="--reveal-delay: 60ms">
            Controlthrive Studios builds Paos. A small number of founder-led
            engagements sit beside it.
          </p>
          <div class="lane__actions reveal" style="--reveal-delay: 120ms">
            <a class="btn-line" href="/services">See services</a>
            <a class="link-quiet" href="/case-studies">Selected work</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 03 Design partners — the commercial motion in one compact panel. -->
    <section class="section section--ruled" id="design-partners">
      <div class="wrap">
        <header class="sec-head">
          <span class="sec-head__index">03</span>
          <span class="sec-head__label">Design partners</span>
        </header>

        <div class="partner-close reveal">
          <div class="partner-close__copy">
            <h2>The product, with the founder beside you.</h2>
            <p>Run Paos on a live raise. Bring a deck, a sentence, or a book.</p>
            <div class="partner-close__actions">
              <a
                class="btn-ink"
                href={bookingUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-growth-cta="join-design-partners"
                data-growth-location="home-design-partners"
                data-growth-wedge="live-mandate">Run a live mandate</a
              >
              <a class="link-quiet" href="/design-partners"
                >See what is included</a
              >
            </div>
          </div>

          <ul class="partner-close__facts">
            {
              partnerSnapshot.map((item) => (
                <li>
                  <strong>{item.title}</strong>
                  <span>{item.copy}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <!-- Who builds it — the person behind a founder-led product. -->
    <section class="section section--ruled" id="founder">
      <div class="wrap">
        <header class="sec-head">
          <span class="sec-head__index">04</span>
          <span class="sec-head__label">Who builds it</span>
        </header>

        <div class="founder">
          <figure class="founder__photo reveal">
            <img
              src="/profile-pic.jpg"
              alt="Portrait of Servando Torres, founder of controlthrive"
              loading="lazy"
            />
          </figure>

          <div class="founder__copy reveal" style="--reveal-delay: 100ms">
            {founderParagraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />

  <script>
    // Staggered reveal on scroll — one orchestrated entrance per section.
    const revealElements = document.querySelectorAll<HTMLElement>(".reveal");
    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    if (reduceMotion || !("IntersectionObserver" in window)) {
      revealElements.forEach((el) => el.classList.add("is-visible"));
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: "0px 0px -8%", threshold: 0.1 },
      );
      revealElements.forEach((el) => observer.observe(el));
    }

    // Agents at work — the front card steps through the five jobs of a raise.
    // Each one carries the record it stands on, and the receipt line names
    // what the claim is grounded in. Every name here is invented.
    const pillars = [
      {
        kind: "Search",
        receipt: "sources attached",
        claim: "Found 12 investors for Project Solís.",
        evidence: "no book to dedup against · 4 withheld, no evidence",
        foot: "a name without a source never reaches this list",
        logged: "✓ Added to mandate — decision logged",
      },
      {
        kind: "Organize",
        receipt: "deck checked",
        claim: "Turned the deck into a review-ready mandate.",
        evidence: "deck p.4 — “seeking €40 million in commitments”",
        foot: "every field opens the page it was read from",
        logged: "✓ Mandate created — decision logged",
      },
      {
        kind: "Pipeline",
        receipt: "this raise",
        claim: "Eight firms are on Project Solís.",
        evidence: "3 identified · 2 talking · 1 in diligence",
        foot: "the pipeline is the scoreboard, not the book",
        logged: "✓ Pursuit moved — decision logged",
      },
      {
        kind: "Matching",
        receipt: "when a book exists",
        claim: "Ranked the book for Project Solís.",
        evidence: "Rockmont leads · committed €18M on Aurora, 2024",
        foot: "matching orders names you already know",
        logged: "✓ Shortlist saved — decision logged",
      },
      {
        kind: "Reporting",
        receipt: "from the raise",
        claim: "Built this month’s client report.",
        evidence: "€40M across 8 pursuits · rows travel as XLSX",
        foot: "every figure opens the rows it was counted from",
        logged: "✓ Version 3 saved — v2 kept as it went out",
      },
    ];

    const rq = document.querySelector<HTMLElement>("[data-rq]");
    const active = rq?.querySelector<HTMLElement>("[data-rq-active]");

    if (rq && active && !reduceMotion) {
      const fields = {
        kind: rq.querySelector("[data-rq-kind]"),
        conf: rq.querySelector("[data-rq-conf]"),
        claim: rq.querySelector("[data-rq-claim]"),
        evidence: rq.querySelector("[data-rq-evidence]"),
        logged: rq.querySelector("[data-rq-logged]"),
        step: rq.querySelector("[data-rq-step]"),
        foot: rq.querySelector("[data-rq-foot]"),
        nextKind: rq.querySelector("[data-rq-next-kind]"),
        nextClaim: rq.querySelector("[data-rq-next-claim]"),
      };

      let index = 0; // Search is what renders on the server

      const render = (i: number) => {
        const current = pillars[i % pillars.length];
        const next = pillars[(i + 1) % pillars.length];

        active.classList.remove("rq__item--approved", "rq__item--active");
        void active.offsetWidth;

        if (fields.kind) fields.kind.textContent = current.kind;
        if (fields.conf) fields.conf.textContent = current.receipt;
        if (fields.claim) fields.claim.textContent = current.claim;
        if (fields.evidence) fields.evidence.textContent = current.evidence;
        if (fields.logged) fields.logged.textContent = current.logged;
        if (fields.foot) fields.foot.textContent = current.foot;
        if (fields.step)
          fields.step.textContent = `${(i % pillars.length) + 1} / ${pillars.length}`;
        if (fields.nextKind) fields.nextKind.textContent = next.kind;
        if (fields.nextClaim) fields.nextClaim.textContent = next.claim;

        active.classList.add("rq__item--active");
      };

      window.setInterval(() => {
        active.classList.add("rq__item--approved");
        window.setTimeout(() => {
          index = (index + 1) % pillars.length;
          render(index);
        }, 1100);
      }, 4400);
    }
  </script>
</Layout>
