---
import Layout from "../layouts/Layout.astro";
import Glyph from "../components/Glyph.astro";
import { bookingUrl } from "../lib/siteContent";

// The cold-outreach pager. One job: a placement agent reads this in two
// minutes and agrees to a screen share.

const svg = (paths: string) =>
  `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;

// Explicit width/height so it stays small even when injected by JS (which
// creates elements without Astro's scoped-style attribute).
const extIcon =
  '<svg viewBox="0 0 16 16" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3.5h3.5V7"/><path d="M12.5 3.5 7.5 8.5"/><path d="M11 9.5v3H3.5V5H6.5"/></svg>';

// Each pillar mirrors the real product panel: a header with counts + an
// "Open …" link, an optional evidence note, and hairline rows that each carry a
// state — an outline action button, or a status (In pipeline / Passed) + link.
const pillars = [
  {
    label: "Mandate",
    flag: "",
    icon: svg(
      '<path d="M2.5 3.5h11"/><path d="M4.6 6v6.5M8 6v6.5M11.4 6v6.5"/>',
    ),
    head: "Mandate · Project Meridian",
    meta: "from the deck · 9 details captured · 2 need review",
    link: "Open raise",
    note: "2 details need review — Paos shows the source page for each one.",
    rows: [
      {
        n: "1",
        name: "Asset class — Real estate",
        detail: "deck p.2 · “private real estate strategies”",
        badge: "p.2",
        ext: false,
        state: "action",
        action: "Accept",
        link: "Edit",
      },
      {
        n: "2",
        name: "Target raise — €40M",
        detail: "deck p.4 · “seeking €40 million”",
        badge: "p.4",
        ext: false,
        state: "in",
        status: "Accepted",
        link: "Open",
      },
      {
        n: "3",
        name: "Check size — €5–15M",
        detail: "deck p.6 · flagged low confidence",
        badge: "p.6",
        ext: false,
        state: "action",
        action: "Accept",
        link: "Edit",
      },
    ],
  },
  {
    label: "Search",
    flag: "",
    icon: svg('<circle cx="7" cy="7" r="4"/><path d="M10.2 10.2 14 14"/>'),
    head: "Names for Project Meridian",
    meta: "8 ready to review · no book to dedup against",
    link: "Open raise",
    note: "4 candidates left out because their claims could not be verified. Empty book — not a Match list.",
    rows: [
      {
        n: "1",
        name: "Rockmont Family Office",
        detail: "€20M avg check · EU real estate · Helsinki",
        badge: "New",
        ext: true,
        state: "in",
        status: "In pipeline",
        link: "Open",
      },
      {
        n: "2",
        name: "Aldwych Capital Office",
        detail: "€10–30M · value-add RE · London",
        badge: "New",
        ext: true,
        state: "action",
        action: "Add to Meridian",
        link: "Pass",
      },
      {
        n: "5",
        name: "Talstein Multi-Family Office",
        detail: "€15M avg · diversified · Zurich",
        badge: "New",
        ext: true,
        state: "passed",
        status: "Passed",
        link: "Reconsider",
      },
    ],
  },
  {
    label: "Pipeline",
    flag: "",
    icon: svg(
      '<path d="M3 3.5h10M3 8h10M3 12.5h10"/><circle cx="3" cy="3.5" r="0.8" fill="currentColor" stroke="none"/><circle cx="3" cy="8" r="0.8" fill="currentColor" stroke="none"/><circle cx="3" cy="12.5" r="0.8" fill="currentColor" stroke="none"/>',
    ),
    head: "Pipeline · Project Meridian",
    meta: "8 firms on this raise · the scoreboard",
    link: "Open raise",
    note: "A pursuit is one investor × this raise. The book is not the work.",
    rows: [
      {
        n: "1",
        name: "Rockmont Family Office",
        detail: "Identified · added from search today",
        badge: "New",
        ext: true,
        state: "in",
        status: "Identified",
        link: "Open",
      },
      {
        n: "2",
        name: "Larkmere Capital",
        detail: "Talking · last call 14 Mar",
        badge: "",
        ext: true,
        state: "in",
        status: "Talking",
        link: "Open",
      },
      {
        n: "3",
        name: "Halcyon Partners",
        detail: "Deep · diligence since 2 Jul",
        badge: "",
        ext: true,
        state: "in",
        status: "Deep",
        link: "Open",
      },
    ],
  },
  {
    label: "Match",
    flag: "",
    icon: svg(
      '<path d="M2 4l3 4-3 4M14 4l-3 4 3 4"/><circle cx="8" cy="8" r="0.7" fill="currentColor" stroke="none"/>',
    ),
    head: "Rank the book · Project Meridian",
    meta: "when a book exists · top 3 of 60",
    link: "Open raise",
    note: "Matching orders names you already know. Hartree excluded — standing policy.",
    rows: [
      {
        n: "1",
        name: "Rockmont Family Office",
        detail: "94 fit · invests EU RE, €20M ticket",
        badge: "94",
        ext: true,
        state: "in",
        status: "Shortlisted",
        link: "Why",
      },
      {
        n: "2",
        name: "Meridian Trust Office",
        detail: "89 fit · value-add mandate match",
        badge: "89",
        ext: true,
        state: "action",
        action: "Add to shortlist",
        link: "Why",
      },
      {
        n: "3",
        name: "Aldwych Capital Office",
        detail: "85 fit · profile only — no behaviour yet",
        badge: "85",
        ext: true,
        state: "action",
        action: "Add to shortlist",
        link: "Why",
      },
    ],
  },
  {
    label: "Report",
    flag: "",
    icon: svg(
      '<path d="M4 2.5h5L12 5.5v8H4z"/><path d="M6.2 8.6h3.6M6.2 11h3.6"/>',
    ),
    head: "Activity report · Project Meridian · v3",
    meta: "your firm’s name and logo · every figure sourced",
    link: "Open PDF",
    note: "",
    rows: [
      {
        n: "1",
        name: "Outreach — 12 emails, 5 meetings, 3 calls",
        detail: "each figure traces to a record",
        badge: "",
        ext: false,
        state: "action",
        action: "Open PDF",
        link: "Export",
      },
      {
        n: "2",
        name: "Pipeline — €40M across 8 investors",
        detail: "3 in diligence · 2 committed",
        badge: "",
        ext: false,
        state: "in",
        status: "In report",
        link: "Open",
      },
      {
        n: "3",
        name: "Coverage — 8 firms on this raise",
        detail: "3 identified · 2 talking · 1 in diligence",
        badge: "",
        ext: false,
        state: "action",
        action: "Open PDF",
        link: "Export",
      },
    ],
  },
];

// Server-render Search first so the page is complete before JS and for
// reduced-motion / screenshot / share.
const start = 1;
const initial = pillars[start];

// Stated as guarantees, not prohibitions. Same five rules, but a placement
// agent should read what they get, not a list of what the software refuses.
const guarantees = [
  {
    title: "The send button stays yours.",
    copy: "Every draft waits in your own mailbox for you to review, edit, and send. Paos never sends investor outreach without you.",
  },
  {
    title: "Every change waits for your review.",
    copy: "A new firm, a corrected detail, or a logged pass only updates the book after you approve it. Paos shows what will change and why.",
  },
  {
    title: "Unclear data stays clearly marked.",
    copy: "If Paos cannot confidently categorize “SPAC sponsor,” it leaves the category open for review instead of guessing.",
  },
  {
    title: "It tells you what the data cannot answer.",
    copy: "When nobody recorded an outcome, Paos says so. It never fills a gap with an invented answer.",
  },
  {
    title: "The book stays the firm’s.",
    copy: "CRM is optional fuel. When you bring a book, it stays the firm’s and exports in full. Nothing investor-facing sends without you.",
  },
];
---

<Layout
  title="Paos — the operating system for placement agents | Controlthrive Studios"
  description="Paos runs the raise. Drop a mandate, find names even with an empty book, and keep the pipeline as the scoreboard. Closed beta."
  ogImage="/api/og/pa-os.png"
  ogImageAlt="Paos by Controlthrive Studios — the operating system for placement agents."
>
  <div class="pa">
    <!-- Slim bar: brand home, and the ask always one click away. -->
    <header class="pa-bar">
      <div class="pa-bar__inner">
        <a class="mark" href="/" aria-label="Controlthrive Studios home">
          <span class="mark__glyph"><Glyph size={15} /></span>
          <span class="mark__word">controlthrive</span>
        </a>
        <span class="pa-bar__chip"
          ><i class="dot-live"></i><span class="brand-name">Paos</span> · closed
          beta</span
        >
        <a
          class="btn-ink pa-bar__cta"
          href={bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          data-growth-cta="join-design-partners"
          data-growth-location="product-bar"
          data-growth-wedge="live-mandate"
        >
          Join the design-partner program
        </a>
      </div>
    </header>

    <main>
      <!-- Hero: the claim, then the product moving under it. -->
      <section class="pa-hero">
        <div class="pa-wrap">
          <p class="tag">
            <i class="dot-live"></i><span class="brand-name">Paos</span> ·
            closed beta
          </p>
          <h1 class="pa-h1">The operating system for placement agents.</h1>
          <p class="pa-lede">
            Drop a mandate — a deck or a sentence. Paos finds names for that
            raise even if the book is empty. The pipeline is the scoreboard.
          </p>
          <div class="pa-actions">
            <a
              class="btn-ink"
              href={bookingUrl}
              target="_blank"
              rel="noopener noreferrer"
              data-growth-cta="join-design-partners"
              data-growth-location="product-hero"
              data-growth-wedge="live-mandate"
              >Join the design-partner program</a
            >
            <a class="link-quiet" href="#loop">See how it works</a>
          </div>
        </div>

        <!-- All five pillars at once; a pulse walks the rail and the frame
             shows the lit pillar's cited receipt. Breadth at a glance. -->
        <div class="pa-wrap">
          <section
            class="os"
            data-os
            aria-label="Paos — run the raise"
          >
            <div class="os__diagram" style={`--i:${start}`}>
              <div class="os__track" aria-hidden="true">
                <span class="os__fill"></span>
              </div>
              <span class="os__orb" aria-hidden="true"></span>
              <ol class="os__rail">
                {
                  pillars.map((p, i) => (
                    <li
                      class={`os__pillar${i === start ? " is-active" : ""}`}
                      data-pillar={i}
                    >
                      <span class="os__dot" />
                      <span class="os__icon" set:html={p.icon} />
                      <span class="os__label">{p.label}</span>
                      {p.flag && <span class="os__flag">{p.flag}</span>}
                    </li>
                  ))
                }
              </ol>
            </div>

            <article class="os__win">
              <div class="os__chrome">
                <span class="os__chromemark"><Glyph size={13} /></span>
                <span class="os__chromeword">Paos</span>
                <span class="os__chromepath" data-os-crumb>Search</span>
                <span class="os__chromelive"><i class="dot-live"></i>live</span>
              </div>

              <div class="os__tile">
                <header class="os__phead">
                  <div class="os__ptitle">
                    <strong data-os-head>{initial.head}</strong>
                    <span class="os__pmeta" data-os-meta>{initial.meta}</span>
                  </div>
                  <span class="os__plink" data-os-link>{initial.link}</span>
                </header>
                <p class="os__pnote" data-os-note hidden={!initial.note}>
                  {initial.note}
                </p>
                <ul class="os__rows" data-os-rows>
                  {
                    initial.rows.map((r) => (
                      <li class="os__row">
                        <span class="os__rn">{r.n}</span>
                        <div class="os__rmain">
                          <div class="os__rnamerow">
                            <span
                              class={`os__rname${r.ext ? " os__rname--link" : ""}`}
                            >
                              {r.name}
                              {r.ext && (
                                <span class="os__ext" set:html={extIcon} />
                              )}
                            </span>
                            {r.badge && (
                              <span class="os__badge">{r.badge}</span>
                            )}
                          </div>
                          <div class="os__rdetail">{r.detail}</div>
                        </div>
                        <div class="os__ractions">
                          {r.state === "action" && (
                            <button type="button" class="os__btn">
                              <span class="os__btnplus">+</span>
                              {r.action}
                            </button>
                          )}
                          {r.state === "in" && (
                            <span class="os__status os__status--in">
                              <span class="os__statustick">✓</span>
                              {r.status}
                            </span>
                          )}
                          {r.state === "passed" && (
                            <span class="os__status os__status--passed">
                              <span class="os__statustick">✕</span>
                              {r.status}
                            </span>
                          )}
                          <span class="os__pass">{r.link}</span>
                        </div>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </article>
          </section>
        </div>
      </section>

      <!-- The loop, one beat per surface. Each demo plays once, on entry. -->
      <div id="loop" class="pa-beats">
        <!-- 01 — the cockpit -->
        <article class="beat" data-beat>
          <div class="beat__copy">
            <p class="beat__eyebrow"><span>01</span>One cockpit</p>
            <h2 class="beat__title">Describe the raise. Go find names.</h2>
            <p class="beat__body">
              A sentence or a deck is enough. Paos treats that as the mandate
              and searches for investors that fit — even if there is nobody in
              the book. Matching the book is a later verb, not the start.
            </p>
            <p class="beat__receipt">
              empty book still searches · names without evidence are withheld
            </p>
          </div>

          <div class="beat__demo">
            <div class="pane">
              <div class="pane__bar">
                <span class="pane__mark"><Glyph size={12} /></span>
                <span class="pane__title">Chat</span>
                <span class="pane__meta">Project Meridian</span>
              </div>
              <div class="pane__body">
                <div class="chat__ask">
                  <span class="chat__who">You</span>
                  <p class="chat__typed">
                    <span data-type>&nbsp;</span><i
                      class="chat__caret"
                      data-caret></i>
                  </p>
                </div>
                <div class="chat__work step" style="--d:1400ms">
                  <span class="chat__spin"></span>no investor book · searching
                  for this raise
                </div>
                <div class="chat__answer step" style="--d:2000ms">
                  <p class="chat__line">
                    8 names to review for Project Meridian. Nothing to dedup
                    against — these are outside names, not a ranked Match list.
                  </p>
                  <ul class="chat__cites">
                    <li>
                      <span class="cite__k">search</span>EU real estate · €5–15M
                      ticket
                    </li>
                    <li>
                      <span class="cite__k">withheld</span>4 names had no source
                      — not shown to you
                    </li>
                    <li>
                      <span class="cite__k">raise</span>the mandate is the job,
                      not the book
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- 02 — the review gate -->
        <article class="beat beat--flip" data-beat>
          <div class="beat__copy">
            <p class="beat__eyebrow"><span>02</span>For review</p>
            <h2 class="beat__title">The agent drafts. You decide.</h2>
            <p class="beat__body">
              A new firm, a corrected field, a logged pass — every change the
              agent wants to make stops here with the old value, the new value
              and the words behind it. Until you approve, nothing is written.
            </p>
            <p class="beat__receipt">
              no silent changes · every approval is recorded
            </p>
          </div>

          <div class="beat__demo">
            <div class="pane">
              <div class="pane__bar">
                <span class="pane__mark"><Glyph size={12} /></span>
                <span class="pane__title">For review</span>
                <span class="pane__meta"
                  ><i class="dot-live"></i>3 waiting on you</span
                >
              </div>
              <div class="pane__body">
                <div class="rev step" style="--d:200ms">
                  <div class="rev__head">
                    <span class="rev__kind">Field change</span>
                    <span class="rev__src">from your 14 Mar call</span>
                  </div>
                  <p class="rev__claim">Halcyon Partners — Country</p>
                  <div class="rev__diff">
                    <span class="rev__old">Sweden</span>
                    <span class="rev__arrow">→</span>
                    <span class="rev__new">Denmark</span>
                  </div>
                  <p class="rev__quote">
                    “We moved the office to Copenhagen last spring.”
                  </p>
                  <div class="rev__actions" data-swap-out>
                    <span class="rev__approve">Approve</span>
                    <span class="rev__edit">Edit</span>
                    <span class="rev__dismiss">Dismiss</span>
                  </div>
                  <p class="rev__done" data-swap-in>
                    ✓ Applied — change recorded
                  </p>
                </div>

                <div class="rev rev--quiet step" style="--d:500ms">
                  <div class="rev__head">
                    <span class="rev__kind">New investor</span>
                    <span class="rev__src"
                      >category needs review — “SPAC sponsor” could not be placed</span
                    >
                  </div>
                  <p class="rev__claim">Gatewood Capital</p>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- 03 — discovery beyond the book -->
        <article class="beat" data-beat>
          <div class="beat__copy">
            <p class="beat__eyebrow"><span>03</span>Search</p>
            <h2 class="beat__title">Find names for this raise.</h2>
            <p class="beat__body">
              Ask for investors that fit the mandate. The book is optional.
              Every candidate comes back with sources and a clear next step:
              add it to the raise, or pass.
            </p>
            <p class="beat__receipt">
              names without evidence are withheld — the run says how many, and
              why
            </p>
          </div>

          <div class="beat__demo">
            <div class="pane">
              <div class="pane__bar">
                <span class="pane__mark"><Glyph size={12} /></span>
                <span class="pane__title">Discovery</span>
                <span class="pane__meta"
                  >8 ready to review · 4 need more evidence</span
                >
              </div>
              <div class="pane__body">
                <p class="disc__note step" style="--d:150ms">
                  4 candidates left out because their claims could not be
                  verified.
                </p>
                <ul class="disc__rows">
                  <li class="disc__row step" style="--d:350ms">
                    <div class="disc__main">
                      <span class="disc__name"
                        >Aldwych Capital Office<span
                          class="os__ext"
                          set:html={extIcon}
                        /></span
                      >
                      <span class="disc__detail"
                        >€10–30M · value-add RE · London · 3 sources</span
                      >
                    </div>
                    <div class="disc__act" data-swap-out>
                      <span class="disc__add"
                        ><span class="os__btnplus">+</span>Add to Meridian</span
                      >
                      <span class="disc__pass">Pass</span>
                    </div>
                    <span class="disc__added" data-swap-in
                      >✓ Added to Meridian</span
                    >
                  </li>
                  <li class="disc__row step" style="--d:500ms">
                    <div class="disc__main">
                      <span class="disc__name"
                        >Talstein Multi-Family Office<span
                          class="os__ext"
                          set:html={extIcon}
                        /></span
                      >
                      <span class="disc__detail"
                        >possible duplicate of Talstein MFO — you choose</span
                      >
                    </div>
                    <div class="disc__act">
                      <span class="disc__add disc__add--warn">Resolve</span>
                      <span class="disc__pass">Pass</span>
                    </div>
                  </li>
                  <li class="disc__row step" style="--d:650ms">
                    <div class="disc__main">
                      <span class="disc__name"
                        >Rockmont Family Office<span
                          class="os__ext"
                          set:html={extIcon}
                        /></span
                      >
                      <span class="disc__detail"
                        >already on your book · 2 pursuits</span
                      >
                    </div>
                    <div class="disc__act">
                      <span class="disc__known">Known</span>
                      <span class="disc__pass">Open</span>
                    </div>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </article>

        <!-- 04 — relationship memory -->
        <article class="beat beat--flip" data-beat>
          <div class="beat__copy">
            <p class="beat__eyebrow"><span>04</span>Relationship memory</p>
            <h2 class="beat__title">Walk into the call knowing.</h2>
            <p class="beat__body">
              Before you meet is assembled from your own records while you read
              it: where the relationship stands, what the firm has told you it
              will not do in its exact words, what it did on past raises — and,
              in the same card, what Paos does not know.
            </p>
            <p class="beat__receipt">
              no status field to rot · nothing saved, nothing sent
            </p>
          </div>

          <div class="beat__demo">
            <div class="pane">
              <div class="pane__bar">
                <span class="pane__mark"><Glyph size={12} /></span>
                <span class="pane__title">Before you meet</span>
                <span class="pane__meta">Larkmere Capital · today 15:00</span>
              </div>
              <div class="pane__body">
                <div class="brief__standing step" style="--d:150ms">
                  <span class="brief__dot"></span>
                  <div>
                    <strong>Warm — two calls, last 14 Mar</strong>
                    <span
                      >derived from 2 interactions · 3 pursuits · 1 restriction</span
                    >
                  </div>
                </div>

                <div class="brief__block step" style="--d:350ms">
                  <span class="brief__k">Will not do</span>
                  <p class="brief__quote">
                    “No US deals. That is firm policy, not this year.”
                  </p>
                  <span class="brief__meta"
                    >standing policy · stated 14 Mar · enforced in Matching</span
                  >
                </div>

                <div class="brief__block step" style="--d:500ms">
                  <span class="brief__k">Past raises</span>
                  <p class="brief__row">
                    Aurora — passed · “timing was wrong for the vintage”
                  </p>
                  <p class="brief__row">Meridian — in diligence since 2 Jul</p>
                </div>

                <div
                  class="brief__block brief__block--unknown step"
                  style="--d:650ms"
                >
                  <span class="brief__k"
                    >What <span class="brand-name">Paos</span> does not know</span
                  >
                  <p class="brief__row">
                    Nobody logged an outcome on the 2 Feb call — listed, never
                    guessed.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </article>

        <!-- 05 — the report -->
        <article class="beat" data-beat>
          <div class="beat__copy">
            <p class="beat__eyebrow"><span>05</span>Reporting</p>
            <h2 class="beat__title">A report every number can defend.</h2>
            <p class="beat__body">
              Under your firm’s name and logo, not ours. Each figure traces to
              the record behind it, the rows travel with it as Excel or CSV, and
              the version you sent in July stays exactly as it went out.
            </p>
            <p class="beat__receipt">
              versioned · white-label · every caveat carried, never hidden
            </p>
          </div>

          <div class="beat__demo">
            <div class="pane">
              <div class="pane__bar">
                <span class="pane__mark"><Glyph size={12} /></span>
                <span class="pane__title">Activity report</span>
                <span class="pane__meta">Project Meridian · v3</span>
              </div>
              <div class="pane__body">
